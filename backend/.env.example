# Server Configuration
PORT=5000
NODE_ENV=development

# Security & CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Authentication Secrets
JWT_SECRET=super_secret_jwt_key_change_in_production_32chars!
JWT_EXPIRES_IN=1d
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# WhatsApp External API Configuration
WHATSAPP_API_URL=https://whatsapp.lexsank.xyz/api/messages/send
WHATSAPP_API_TOKEN=your_token_here
WHATSAPP_PHONE=584247731176
WEBHOOK_SECRET=your_webhook_secret_here

# Webhook para enviar alertas instantáneas a un sistema de destino externo
WHATSAPP_ALERT_WEBHOOK_URL=https://your-external-app.com/webhook-receiver
WHATSAPP_ALERT_WEBHOOK_SECRET=your_alert_webhook_signature_secret_here

